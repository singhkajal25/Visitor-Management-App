 "html": "<!-- visitor_pass_template.html -->\n<style>\n    @page {\n        size: A4 portrait;\n        margin: 0mm;\n    }\n\n    @media print {\n        body { margin: 0; padding: 0; background: #ffffff; }\n        .pass-badge, .pass-badge * { visibility: visible; }\n        .no-print { display: none !important; }\n    }\n\n    .pass-container {\n        width: 100%;\n        padding-top: 30px;\n        text-align: center;\n    }\n\n    .pass-badge {\n        width: 520px;\n        margin: 0 auto;\n        background: #ffffff;\n        border-radius: 12px;\n        border: 1px solid #e2e8f0;\n        border-collapse: separate;\n        border-spacing: 0;\n        overflow: hidden;\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);\n    }\n\n    /* Sidebar */\n    .badge-sidebar {\n        width: 175px;\n        background: #0f172a;\n        color: #ffffff;\n        padding: 24px 12px;\n        text-align: center;\n        vertical-align: middle;\n    }\n\n    .photo-frame {\n        width: 85px;\n        height: 85px;\n        border-radius: 50%;\n        border: 3px solid #38bdf8;\n        margin: 0 auto 10px auto;\n        overflow: hidden;\n        background-color: #334155;\n        background-size: cover;\n        background-position: center center;\n        background-repeat: no-repeat;\n    }\n\n    .photo-placeholder {\n        font-size: 32px;\n        color: #94a3b8;\n        line-height: 85px;\n        display: block;\n    }\n\n    .sidebar-visitor-name {\n        font-size: 14px;\n        font-weight: 700;\n        margin: 0 0 2px 0;\n        color: #ffffff;\n        line-height: 1.2;\n        word-break: break-word;\n    }\n\n    .sidebar-pass-id {\n        font-size: 10px;\n        color: #94a3b8;\n        font-weight: 600;\n        margin-bottom: 12px;\n        display: block;\n        letter-spacing: 0.5px;\n    }\n\n    .status-badge {\n        padding: 4px 10px;\n        border-radius: 12px;\n        font-size: 9px;\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        display: inline-block;\n    }\n    .status-approved { background: #10b981; color: #ffffff; }\n    .status-pending { background: #f59e0b; color: #ffffff; }\n    .status-rejected { background: #ef4444; color: #ffffff; }\n\n    /* Right Section Redesign */\n    .badge-content {\n        width: 345px;\n        padding: 20px;\n        vertical-align: top;\n        background: #ffffff;\n        text-align: left;\n    }\n\n    .header-bar {\n        display: block;\n        margin-bottom: 14px;\n        padding-bottom: 8px;\n        border-bottom: 2px solid #38bdf8;\n    }\n\n    .header-title {\n        font-size: 12px;\n        text-transform: uppercase;\n        letter-spacing: 1.2px;\n        font-weight: 800;\n        color: #0369a1;\n        margin: 0;\n    }\n\n    .details-grid {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    .details-grid td {\n        padding: 6px 4px;\n        vertical-align: top;\n    }\n\n    .field-card {\n        background: #f8fafc;\n        border-radius: 6px;\n        padding: 6px 8px;\n        border: 1px solid #f1f5f9;\n    }\n\n    .detail-label {\n        font-size: 8px;\n        text-transform: uppercase;\n        color: #64748b;\n        font-weight: 700;\n        letter-spacing: 0.5px;\n        display: block;\n        margin-bottom: 2px;\n    }\n\n    .detail-value {\n        font-size: 11px;\n        color: #0f172a;\n        font-weight: 600;\n        display: block;\n        word-break: break-all;\n        line-height: 1.25;\n    }\n\n    .badge-footer-table {\n        width: 100%;\n        margin-top: 12px;\n        padding-top: 8px;\n        border-top: 1px dashed #cbd5e1;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    .footer-notes {\n        font-size: 8px;\n        color: #64748b;\n        line-height: 1.3;\n        padding-right: 8px;\n        vertical-align: middle;\n    }\n\n    .qr-box {\n        width: 50px;\n        text-align: right;\n        vertical-align: middle;\n    }\n\n    .qr-box img {\n        width: 50px;\n        height: 50px;\n        display: block;\n    }\n\n    .print-btn {\n        display: block;\n        width: 100%;\n        max-width: 520px;\n        margin: 16px auto;\n        padding: 10px;\n        background: #0284c7;\n        color: #ffffff;\n        border: none;\n        border-radius: 6px;\n        font-weight: 600;\n        font-size: 13px;\n        cursor: pointer;\n    }\n</style>\n\n<div class=\"pass-container\">\n    <table class=\"pass-badge\">\n        <tr>\n            <!-- Left Sidebar -->\n            <td class=\"badge-sidebar\">\n                {% set photo_url = doc.visitor_photo or doc.image or doc.photo %}\n                \n                <div class=\"photo-frame\" {% if photo_url %}style=\"background-image: url('{{ frappe.utils.get_url(photo_url) }}');\"{% endif %}>\n                    {% if not photo_url %}\n                        <span class=\"photo-placeholder\">\ud83d\udc64</span>\n                    {% endif %}\n                </div>\n\n                <h3 class=\"sidebar-visitor-name\">{{ doc.visitor_full_name }}</h3>\n                <span class=\"sidebar-pass-id\">{{ doc.name }}</span>\n\n                {% if doc.workflow_state == 'Approved' %}\n                    <span class=\"status-badge status-approved\">Approved</span>\n                {% elif doc.workflow_state == 'Pending Approval' %}\n                    <span class=\"status-badge status-pending\">Pending</span>\n                {% else %}\n                    <span class=\"status-badge status-rejected\">{{ doc.workflow_state or 'Draft' }}</span>\n                {% endif %}\n            </td>\n\n            <!-- Right Content -->\n            <td class=\"badge-content\">\n                <div class=\"header-bar\">\n                    <h2 class=\"header-title\">Visitor Entry Pass</h2>\n                </div>\n\n                <table class=\"details-grid\">\n                    <tr>\n                        <td style=\"width: 50%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Mobile</span>\n                                <span class=\"detail-value\">{{ doc.mobile_number or 'N/A' }}</span>\n                            </div>\n                        </td>\n                        <td style=\"width: 50%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Email</span>\n                                <span class=\"detail-value\">{{ doc.email_id or 'N/A' }}</span>\n                            </div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td style=\"width: 50%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Person To Visit</span>\n                                <span class=\"detail-value\">{{ doc.person_to_visit or 'N/A' }}</span>\n                            </div>\n                        </td>\n                        <td style=\"width: 50%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Department</span>\n                                <span class=\"detail-value\">{{ doc.department or 'N/A' }}</span>\n                            </div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td style=\"width: 50%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Visit Date</span>\n                                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.visit_date) if doc.visit_date else 'N/A' }}</span>\n                            </div>\n                        </td>\n                        <td style=\"width: 50%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Expected Check-In</span>\n                                <span class=\"detail-value\">{{ doc.expected_checkin or 'N/A' }}</span>\n                            </div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"2\" style=\"width: 100%;\">\n                            <div class=\"field-card\">\n                                <span class=\"detail-label\">Purpose of Visit</span>\n                                <span class=\"detail-value\">{{ doc.purpose_of_visit or 'N/A' }}</span>\n                            </div>\n                        </td>\n                    </tr>\n                </table>\n\n                <table class=\"badge-footer-table\">\n                    <tr>\n                        <td class=\"footer-notes\">\n                            Please display this pass at all times inside the premises. Return pass upon exit.\n                        </td>\n                        {% if doc.qr_code %}\n                        <td class=\"qr-box\">\n                            <img src=\"{{ frappe.utils.get_url(doc.qr_code) }}\" alt=\"QR Code\">\n                        </td>\n                        {% endif %}\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</div>\n\n<button class=\"print-btn no-print\" onclick=\"window.print()\">Print Visitor Pass</button>",
